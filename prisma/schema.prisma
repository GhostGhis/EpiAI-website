generator client {
  provider      = "prisma-client-js"
  // native = machine locale
  // debian-openssl-3.0.x = image de build Netlify (Ubuntu)
  // rhel-openssl-3.0.x = runtime Netlify Functions (Amazon Linux / Node 20)
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ResourceType {
  pdf
  code
  video
  article
  course
  dataset
}

enum ResourceDifficulty {
  beginner
  intermediate
  advanced
}

enum RegistrationStatus {
  registered
  cancelled
  attended
}

enum MembershipStatus {
  pending
  testing
  interviewing
  approved
  rejected
}

enum TeamSection {
  executive
  referent
  pole
  mentor
}

enum NotificationType {
  membership
  event
  forum
  activity
  chat
  system
}

enum BlogPostStatus {
  draft
  published
}

enum MemberStatus {
  active
  pending
  approved
}

// ─── Users (sync Clerk) ───────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  clerkId          String   @unique
  email            String
  firstName        String   @default("")
  lastName         String   @default("")
  role             String   @default("membre")
  roleLevel        Int      @default(1) @map("role_level")
  memberStatus     MemberStatus @default(pending) @map("member_status")
  imageUrl         String?  @map("image_url")
  linkedin         String?
  onboardingDone   Boolean  @default(false) @map("onboarding_done")
  onboardingStep   Int      @default(0) @map("onboarding_step")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  notifications    Notification[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Resources ───────────────────────────────────────────────────────────────

model Resource {
  id             String             @id @default(cuid())
  title          String
  description    String
  type           ResourceType
  url            String?
  fileUrl        String?            @map("file_url")
  fileSize       Int?               @map("file_size")
  fileType       String?            @map("file_type")
  thumbnailUrl   String?            @map("thumbnail_url")
  isDownloadable Boolean            @default(false) @map("is_downloadable")
  categoryId     String             @map("category_id")
  tags           String[]           @default([])
  difficulty     ResourceDifficulty @default(beginner)
  author         String?
  duration       String?
  isFeatured     Boolean            @default(false) @map("is_featured")
  isPublished    Boolean            @default(true) @map("is_published")
  viewCount      Int                @default(0) @map("view_count")
  downloadCount  Int                @default(0) @map("download_count")
  createdBy      String             @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([categoryId, createdAt])
  @@index([isFeatured, isPublished])
  @@map("resources")
}

// ─── Events & Activities (miroir) ────────────────────────────────────────────

model Event {
  id               String   @id @default(cuid())
  title            String
  description      String
  content          String
  titleEn          String?  @map("title_en")
  titleFr          String?  @map("title_fr")
  descriptionEn    String?  @map("description_en")
  descriptionFr    String?  @map("description_fr")
  contentEn        String?  @map("content_en")
  contentFr        String?  @map("content_fr")
  categoryId       String   @map("category_id")
  date             DateTime
  endDate          DateTime? @map("end_date")
  location         String
  isOnline         Boolean  @default(false) @map("is_online")
  onlineLink       String?  @map("online_link")
  capacity         Int
  registeredCount  Int      @default(0) @map("registered_count")
  imageUrl         String?  @map("image_url")
  gallery          String[] @default([])
  videoUrls        String[] @default([]) @map("video_urls")
  isPublished      Boolean  @default(false) @map("is_published")
  isFeatured       Boolean  @default(false) @map("is_featured")
  createdBy        String   @map("created_by")
  linkedActivityId String?  @unique @map("linked_activity_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  registrations    EventRegistration[]

  @@index([date, isPublished])
  @@index([categoryId])
  @@map("events")
}

model Activity {
  id                   String   @id @default(cuid())
  title                String
  description          String
  date                 DateTime
  endDate              DateTime? @map("end_date")
  location             String
  isOnline             Boolean  @default(false) @map("is_online")
  onlineLink           String?  @map("online_link")
  registrationDeadline DateTime @map("registration_deadline")
  isMandatory          Boolean  @default(true) @map("is_mandatory")
  isActive             Boolean  @default(true) @map("is_active")
  createdBy            String   @map("created_by")
  createdByName        String   @map("created_by_name")
  linkedEventId        String?  @unique @map("linked_event_id")
  moduleId             String?  @map("module_id")
  attendanceCode       String?  @map("attendance_code")
  attendanceCodeExpiresAt DateTime? @map("attendance_code_expires_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  registrations        ActivityRegistration[]
  attendances          Attendance[]
  module               LearningModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([date, isActive])
  @@index([moduleId])
  @@map("activities")
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String             @map("event_id")
  userId       String             @map("user_id")
  userName     String             @map("user_name")
  userEmail    String             @map("user_email")
  status       RegistrationStatus @default(registered)
  registeredAt DateTime           @default(now()) @map("registered_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model ActivityRegistration {
  id                   String   @id @default(cuid())
  activityId           String   @map("activity_id")
  userId               String   @map("user_id")
  userName             String   @map("user_name")
  userEmail            String   @map("user_email")
  registeredAt         DateTime @default(now()) @map("registered_at")
  registeredBy         String?  @map("registered_by")
  isForcedRegistration Boolean  @default(false) @map("is_forced_registration")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  activity             Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@map("activity_registrations")
}

model Attendance {
  id            String   @id @default(cuid())
  activityId    String   @map("activity_id")
  userId        String   @map("user_id")
  userName      String   @map("user_name")
  userEmail     String   @map("user_email")
  isPresent     Boolean  @map("is_present")
  wasRegistered Boolean  @map("was_registered")
  markedBy      String   @map("marked_by")
  markedByName  String   @map("marked_by_name")
  markedAt      DateTime @default(now()) @map("marked_at")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@map("attendances")
}

// ─── Modules pédagogiques (en plus de l'intra / events existants) ────────────

model LearningModule {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  leadUserId  String   @map("lead_user_id")
  leadName    String   @map("lead_name")
  leadGithub  String?  @map("lead_github")
  lead2UserId String?  @map("lead2_user_id")
  lead2Name   String?  @map("lead2_name")
  lead2Github String?  @map("lead2_github")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  enrollments ModuleEnrollment[]
  projects    ModuleProject[]
  activities  Activity[]
  materials   ModuleMaterial[]

  @@index([leadUserId])
  @@index([lead2UserId])
  @@map("learning_modules")
}

model ModuleEnrollment {
  id         String   @id @default(cuid())
  moduleId   String   @map("module_id")
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  userEmail      String   @map("user_email")
  githubUsername String?  @map("github_username")
  level          Int      @default(0)
  enrolledAt     DateTime @default(now()) @map("enrolled_at")
  forced         Boolean  @default(false)

  module     LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId])
  @@index([userId])
  @@map("module_enrollments")
}

model ModuleProject {
  id          String   @id @default(cuid())
  moduleId    String   @map("module_id")
  title       String
  description String   @default("")
  pdfUrl      String?  @map("pdf_url")
  startsAt    DateTime @map("starts_at")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions ModuleSubmission[]
  repos       ModuleProjectRepo[]
  materials   ModuleMaterial[]

  @@index([moduleId, startsAt])
  @@map("module_projects")
}

model ModuleMaterial {
  id        String   @id @default(cuid())
  moduleId  String   @map("module_id")
  projectId String?  @map("project_id")
  kind      String
  title     String
  url       String?
  fileName  String?  @map("file_name")
  mimeType  String?  @map("mime_type")
  fileSize  Int?     @map("file_size")
  bytes     Bytes?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  module  LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  project ModuleProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([moduleId, createdAt])
  @@map("module_materials")
}

model ModuleSubmission {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  notes     String   @default("")
  fileUrl   String?  @map("file_url")
  points    Int      @default(10)
  createdAt DateTime @default(now()) @map("created_at")

  project   ModuleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("module_submissions")
}

model ModuleProjectRepo {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  repoUrl   String   @map("repo_url")
  repoName  String   @map("repo_name")
  createdAt DateTime @default(now()) @map("created_at")

  project   ModuleProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("module_project_repos")
}

model GithubActivity {
  id          String   @id @default(cuid())
  repoId      String   @map("repo_id")
  userId      String   @map("user_id")
  projectId   String   @map("project_id")
  sha         String   @unique
  message     String
  additions   Int      @default(0)
  deletions   Int      @default(0)
  committedAt DateTime @map("committed_at")
  burst       Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, projectId, committedAt])
  @@map("github_activities")
}

model MemberContract {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")

  @@map("member_contracts")
}

model MembershipDue {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  userName   String    @map("user_name")
  userEmail  String    @map("user_email")
  period     String
  baseAmount Int       @default(1500) @map("base_amount")
  lateFee    Int       @default(0) @map("late_fee")
  status     String    @default("pending")
  dueDate    DateTime  @map("due_date")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([userId, period])
  @@index([status, dueDate])
  @@map("membership_dues")
}

// ─── Forum ───────────────────────────────────────────────────────────────────

model Thread {
  id         String   @id @default(cuid())
  title      String
  content    String
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  categoryId String   @map("category_id")
  tags       String[] @default([])
  views      Int      @default(0)
  isPinned   Boolean  @default(false) @map("is_pinned")
  isLocked   Boolean  @default(false) @map("is_locked")
  replyCount Int      @default(0) @map("reply_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  replies    Reply[]

  @@index([categoryId, createdAt])
  @@map("threads")
}

model Reply {
  id         String   @id @default(cuid())
  threadId   String   @map("thread_id")
  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  content    String
  isEdited   Boolean  @default(false) @map("is_edited")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("replies")
}

// ─── Team & Membership ───────────────────────────────────────────────────────

model TeamMember {
  id           String      @id @default(cuid())
  name         String
  role         String
  title        String?
  section      TeamSection
  poleKey      String?     @map("pole_key")
  description  String?
  photoUrl     String?     @map("photo_url")
  linkedin     String?
  github       String?
  twitter      String?
  clerkId      String?     @unique @map("clerk_id")
  displayOrder Int         @default(0) @map("display_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([section, displayOrder])
  @@map("team_members")
}

model MembershipApplication {
  id              String           @id @default(cuid())
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  email           String           @unique
  whatsapp        String
  motivations     String
  status          MembershipStatus @default(pending)
  pipelineStage   String           @default("received") @map("pipeline_stage")
  accessToken     String           @unique @default(dbgenerated("gen_random_uuid()")) @map("access_token")
  reviewedBy      String?          @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at")
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  examBookings      ExamBooking[]
  examAttempts      ExamAttempt[]
  interviewBookings InterviewBooking[]

  @@index([status, createdAt])
  @@index([pipelineStage])
  @@map("membership_applications")
}

model EntranceExam {
  id              String   @id @default(cuid())
  title           String
  durationMinutes Int      @map("duration_minutes")
  passingScore    Float?   @map("passing_score")
  instructions    String   @default("")
  examPdfName     String?  @map("exam_pdf_name")
  examPdfBytes    Bytes?   @map("exam_pdf_bytes")
  keyPdfName      String?  @map("key_pdf_name")
  keyPdfBytes     Bytes?   @map("key_pdf_bytes")
  published       Boolean  @default(false)
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  questions EntranceExamQuestion[]
  slots     ExamSlot[]
  attempts  ExamAttempt[]

  @@map("entrance_exams")
}

model EntranceExamQuestion {
  id             String @id @default(cuid())
  examId         String @map("exam_id")
  sortOrder      Int    @default(0) @map("sort_order")
  prompt         String
  type           String @default("short")
  points         Float  @default(1)
  officialAnswer String @default("") @map("official_answer")
  gradingHint    String @default("") @map("grading_hint")

  exam    EntranceExam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@index([examId, sortOrder])
  @@map("entrance_exam_questions")
}

model ExamSlot {
  id       String   @id @default(cuid())
  examId   String   @map("exam_id")
  startsAt DateTime @map("starts_at")
  capacity Int      @default(40)
  label    String   @default("")

  exam     EntranceExam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  bookings ExamBooking[]

  @@index([examId, startsAt])
  @@map("exam_slots")
}

model ExamBooking {
  id               String    @id @default(cuid())
  slotId           String    @map("slot_id")
  applicationId    String    @map("application_id")
  examLogin        String    @unique @map("exam_login")
  examPasswordHash String    @default("") @map("exam_password_hash")
  credentialsSentAt DateTime? @map("credentials_sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  slot        ExamSlot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  attempt     ExamAttempt?

  @@unique([slotId, applicationId])
  @@index([applicationId])
  @@map("exam_bookings")
}

model ExamAttempt {
  id             String    @id @default(cuid())
  bookingId      String    @unique @map("booking_id")
  applicationId  String    @map("application_id")
  examId         String    @map("exam_id")
  startedAt      DateTime? @map("started_at")
  submittedAt    DateTime? @map("submitted_at")
  timedOut       Boolean   @default(false) @map("timed_out")
  autoScore      Float?    @map("auto_score")
  adminScore     Float?    @map("admin_score")
  maxScore       Float     @default(0) @map("max_score")
  adminNotes     String    @default("") @map("admin_notes")
  gradeStatus    String    @default("pending") @map("grade_status")
  integrityFlag  Boolean   @default(false) @map("integrity_flag")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  booking     ExamBooking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  exam        EntranceExam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers     ExamAnswer[]
  events      ExamIntegrityEvent[]

  @@index([examId, gradeStatus])
  @@index([applicationId])
  @@map("exam_attempts")
}

model ExamAnswer {
  id          String @id @default(cuid())
  attemptId   String @map("attempt_id")
  questionId  String @map("question_id")
  response    String @default("")
  autoScore   Float? @map("auto_score")
  adminScore  Float? @map("admin_score")

  attempt  ExamAttempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question EntranceExamQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

model ExamIntegrityEvent {
  id        String   @id @default(cuid())
  attemptId String   @map("attempt_id")
  type      String
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
  @@map("exam_integrity_events")
}

model InterviewTemplate {
  id         String   @id @default(cuid())
  title      String   @default("Entretien de motivation")
  pdfName    String?  @map("pdf_name")
  pdfBytes   Bytes?   @map("pdf_bytes")
  official   Boolean  @default(false)
  guideJson  String   @default("") @map("guide_json")
  active     Boolean  @default(true)
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  questions InterviewQuestion[]

  @@map("interview_templates")
}

model InterviewQuestion {
  id           String  @id @default(cuid())
  templateId   String  @map("template_id")
  sortOrder    Int     @default(0) @map("sort_order")
  code         String  @default("")
  section      String  @default("")
  prompt       String
  kind         String  @default("scale")
  maxPoints    Float   @default(5) @map("max_points")
  lookingFor   String  @default("") @map("looking_for")
  followUp     String  @default("") @map("follow_up")
  criteriaJson String  @default("[]") @map("criteria_json")
  isVeto       Boolean @default(false) @map("is_veto")

  template InterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scores   InterviewScore[]

  @@index([templateId, sortOrder])
  @@map("interview_questions")
}

model InterviewSlot {
  id       String   @id @default(cuid())
  startsAt DateTime @map("starts_at")
  room     String   @default("")
  capacity Int      @default(1)
  label    String   @default("")

  bookings InterviewBooking[]

  @@index([startsAt])
  @@map("interview_slots")
}

model InterviewBooking {
  id            String    @id @default(cuid())
  slotId        String    @map("slot_id")
  applicationId String    @map("application_id")
  totalScore    Float?    @map("total_score")
  maxScore      Float     @default(0) @map("max_score")
  notes         String    @default("")
  closureJson   String    @default("{}") @map("closure_json")
  status        String    @default("scheduled")
  scoredBy      String?   @map("scored_by")
  scoredAt      DateTime? @map("scored_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  slot        InterviewSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  application MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scores      InterviewScore[]

  @@unique([applicationId])
  @@index([slotId])
  @@map("interview_bookings")
}

model InterviewScore {
  id          String @id @default(cuid())
  bookingId   String @map("booking_id")
  questionId  String @map("question_id")
  points      Float  @default(0)
  remark      String @default("")

  booking  InterviewBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([bookingId, questionId])
  @@map("interview_scores")
}

/// Membres autorisés à voir/corriger les copies et évaluer les entretiens
/// (sans rôle admin ni membership.manage).
model AdmissionReviewer {
  id          String   @id @default(cuid())
  clerkUserId String   @unique @map("clerk_user_id")
  email       String   @default("")
  displayName String   @default("") @map("display_name")
  addedBy     String   @map("added_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admission_reviewers")
}

// ─── Projects (bilingue) ─────────────────────────────────────────────────────

model Project {
  id           String   @id @default(cuid())
  titleEn      String   @map("title_en")
  titleFr      String   @map("title_fr")
  descEn       String   @map("desc_en")
  descFr       String   @map("desc_fr")
  contentEn    String?  @map("content_en")
  contentFr    String?  @map("content_fr")
  imageUrl     String?  @map("image_url")
  status       String?
  techStack    String[] @default([]) @map("tech_stack")
  githubUrl    String?  @map("github_url")
  discoveryUrl String?  @map("discovery_url")
  published    Boolean  @default(false)
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

// ─── Blog ────────────────────────────────────────────────────────────────────

model BlogPost {
  id            String         @id @default(cuid())
  slug          String         @unique
  titleEn       String         @map("title_en")
  titleFr       String         @map("title_fr")
  excerptEn     String         @map("excerpt_en")
  excerptFr     String         @map("excerpt_fr")
  contentEn     String         @map("content_en")
  contentFr     String         @map("content_fr")
  category      String
  imageUrl      String?        @map("image_url")
  authorName    String         @map("author_name")
  status        BlogPostStatus @default(draft)
  publishedAt   DateTime?      @map("published_at")
  linkedEventId String?        @unique @map("linked_event_id")
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// ─── Partners ────────────────────────────────────────────────────────────────

model Partner {
  id          String   @id @default(cuid())
  name        String
  description String?
  logoUrl     String?  @map("logo_url")
  websiteUrl  String?  @map("website_url")
  type        String   @default("partner")
  displayOrder Int     @default(0) @map("display_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

// ─── Notifications ─────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
